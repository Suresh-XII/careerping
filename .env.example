# ============================================================
# CAREERPING ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================
# Copy this file to .env locally. Never commit secrets to git.

# 1. Custom Domain / Public Website Canonical URL
# Default production root domain is https://careerping.in (or https://careerping.com)
VITE_SITE_URL=https://careerping.in

# 2. Vite Base Path
# For custom root domain (careerping.in): leave as '/'
# For GitHub Pages fallback (username.github.io/careerping/): use '/careerping/'
VITE_BASE_PATH=/

# 3. Supabase Configuration (Will be connected in Stage 2)
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_anon_key_here

# 4. Google AdSense / Monetization Configuration (Optional)
# Replace with your approved Google AdSense Publisher ID (e.g., ca-pub-XXXXXXXXXXXXXXXX)
VITE_ADSENSE_CLIENT_ID=ca-pub-7188164081014168

# IMPORTANT SECURITY NOTE:
# - NEVER put Supabase Service Role Keys or Gemini API Keys in frontend .env!
# - Service keys and Gemini keys reside exclusively inside Supabase Edge Function Secrets.
